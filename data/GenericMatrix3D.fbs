namespace link_dev;

enum MatrixScalarType : uint8 {
    NotSpecified = 0,
    Float = 1,
    Double = 2,
    Int8 = 3,
    Int16 = 4,
    Int32 = 5,
    Int64 = 6,
    UInt8 = 7,
    UInt16 = 8,
    UInt32 = 9,
    UInt64 = 10
}

enum StorageOrderType : uint8 {
    ColumnMajor = 0,
    RowMajor = 1
}

table GenericMatrix3D {
    rows: uint32;
    cols: uint32;
    depth: uint32;
    scalar_type: MatrixScalarType;
    storage_order: StorageOrderType;
    data_bytes: [uint8];
}
